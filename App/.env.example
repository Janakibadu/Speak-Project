# Copy this file to .env and adjust as needed.
# These DB_* values must match docker-compose.yml.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=speak
DB_USER=speak_app
DB_PASSWORD=speak
DB_ROOT_PASSWORD=speak

JWT_SECRET=change-this-to-a-long-random-string

# Key for hashing student access codes (HMAC). Changing it invalidates every
# existing code: teachers must then regenerate their students' codes.
ACCESS_CODE_SECRET=change-this-to-another-long-random-string

# Teacher sessions end after this many idle minutes, and at the latest after
# TEACHER_MAX_SESSION_HOURS (NFR09).
TEACHER_IDLE_MINUTES=30
TEACHER_MAX_SESSION_HOURS=12

PORT=3000

# Base URL of the frontend, used to build links sent to users (e.g. the
# teacher password-reset link). Point this at wherever the React app is
# actually served from.
FRONTEND_URL=http://localhost:5173

# Server tests (npm test in server/) drop and recreate this database.
# Defaults: root@127.0.0.1:3306, password = DB_ROOT_PASSWORD.
# TEST_DB_HOST=127.0.0.1
# TEST_DB_USER=root
# TEST_DB_PASSWORD=
# TEST_DB_NAME=speak_test
